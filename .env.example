# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/thesnapcapsule

# Google Cloud → Google Auth Platform → Clients → your Web client.
# Only the client ID is needed; the client secret is NOT used here.
GOOGLE_CLIENT_ID=238383179178-dn4hei0qsd1t5ge037bghbispjr0gsoj.apps.googleusercontent.com

# Long random secret for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=https://thesnapcapsule.com,https://www.thesnapcapsule.com,http://localhost:3000

# Set to 1 when running behind a hosting proxy (Render, Railway, etc.)
TRUST_PROXY=0

# ── Login codes by email ─────────────────────────────────────────────────
OTP_TTL_MINUTES=10

# SMTP for sending login codes. Required in production. Leave SMTP_HOST empty
# in development to print codes in the terminal instead.
# Examples:
#   Google Workspace: smtp.gmail.com, port 465, SMTP_USER=support@thesnapcapsule.com,
#                     SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>
#   Resend:           smtp.resend.com, port 465, SMTP_USER=resend, SMTP_PASS=<API key>
#   Brevo:            smtp-relay.brevo.com, port 587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Snap Capsule <support@thesnapcapsule.com>
