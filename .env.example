# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/thesnapcapsule

# Google Cloud → Google Auth Platform → Clients → your Web client.
# Only the client ID is needed; the client secret is NOT used here.
GOOGLE_CLIENT_ID=238383179178-dn4hei0qsd1t5ge037bghbispjr0gsoj.apps.googleusercontent.com

# Long random secret for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=https://thesnapcapsule.com,https://www.thesnapcapsule.com,http://localhost:3000

# Set to 1 when running behind a hosting proxy (Render, Railway, etc.)
TRUST_PROXY=0
